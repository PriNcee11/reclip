{
  "manifest_version": 3,
  "name": "ReClip",
  "description": "Manda los vídeos de la página a tu ReClip y guarda el fichero al terminar.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ReClip",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "permissions": [
    "alarms",
    "contextMenus",
    "downloads",
    "notifications",
    "scripting",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": ["<all_urls>"]
}
